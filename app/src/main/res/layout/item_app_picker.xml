<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_list_row">

    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="centerInside"
        android:layout_marginEnd="14dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_app_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/text_primary" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_app_pkg" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="11sp"
            android:textColor="@color/text_tertiary" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <CheckBox android:id="@+id/cb_whitelist" android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/accent"
        android:clickable="false"/>

</LinearLayout>
