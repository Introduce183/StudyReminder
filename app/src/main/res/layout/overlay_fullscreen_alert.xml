<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8A0F2026">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_overlay_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="😤"
            android:textSize="72sp" />

        <ImageView
            android:id="@+id/iv_overlay_character"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_character_default" />

        <TextView
            android:id="@+id/tv_overlay_character_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="学习监督者"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.05" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:background="@drawable/bg_overlay_glass">

            <TextView
                android:id="@+id/tv_overlay_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:padding="24dp"
                android:text="还在玩？！学习时间到了！！"
                android:textColor="#12393E"
                android:textSize="21sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_overlay_snooze"
            style="@style/Widget.StudyReminder.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:text="👀 再看 30 秒"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_overlay_confirm"
            style="@style/Widget.StudyReminder.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✅ 知道了，返回桌面去学习"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
