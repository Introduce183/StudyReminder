<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8A0F2026">

    <View
        android:id="@+id/view_fullscreen_glow_1"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-30dp"
        android:alpha="0.55"
        android:background="@drawable/bg_panel_soft" />

    <View
        android:id="@+id/view_fullscreen_glow_2"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-50dp"
        android:layout_marginStart="-20dp"
        android:alpha="0.42"
        android:background="@drawable/bg_panel_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_overlay_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="😤"
            android:textSize="72sp" />

        <ImageView
            android:id="@+id/iv_overlay_character"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_character_default" />

        <TextView
            android:id="@+id/tv_overlay_character_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="学习监督者"
            android:textColor="#E8FFFE"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            android:background="@drawable/bg_overlay_glass">

            <TextView
                android:id="@+id/tv_overlay_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:padding="24dp"
                android:text="还在玩？！学习时间到了！！"
                android:textColor="#12393E"
                android:textSize="22sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_overlay_confirm"
            style="@style/Widget.StudyReminder.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✅ 知道了，返回桌面去学习"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
