<?xml version="1.0" encoding="utf-8"?>
<!-- 小窗提醒：带角色图片+挑衅文字，可拖动，点确认返桌面 -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#FAFAFA"
    app:cardElevation="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 角色区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/iv_small_character"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_character_default"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_small_character_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学习监督者"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_small_emoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😤"
                        android:textSize="20sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_small_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="还在玩？该学习啦！"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        android:maxLines="3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 确认按钮 -->
        <Button
            android:id="@+id/btn_small_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="好的，我去学习了！"
            android:backgroundTint="#FF5C5C"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
