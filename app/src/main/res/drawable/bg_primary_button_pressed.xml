<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="0"
                android:startColor="#B95CCFD8"
                android:centerColor="#C46CD8E7"
                android:endColor="#BC78C8EB" />
            <stroke
                android:width="1dp"
                android:color="#D6F7FFFF" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#88FFFFFF"
                android:endColor="#0FFFFFFF" />
        </shape>
    </item>
</layer-list>
