<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="0"
                android:startColor="#98D9F0F5"
                android:centerColor="#9AD5EBF2"
                android:endColor="#92C6E6F2" />
            <stroke
                android:width="1dp"
                android:color="#B8FFFFFF" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="32dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#74FFFFFF"
                android:endColor="#08FFFFFF" />
        </shape>
    </item>
</layer-list>
