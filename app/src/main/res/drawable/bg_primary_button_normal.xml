<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="0"
                android:startColor="#C86FE6F0"
                android:centerColor="#D37CEAF8"
                android:endColor="#CC8FD9FF" />
            <stroke
                android:width="1dp"
                android:color="#F2EDFFFF" />
            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <item
        android:left="3dp"
        android:top="2dp"
        android:right="3dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#CCFFFFFF"
                android:endColor="#18FFFFFF" />
        </shape>
    </item>

    <item
        android:left="10dp"
        android:top="8dp"
        android:right="90dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
